# ---------------------------------------------------------------------
# Environment Variables & Sensitive Credentials
# ---------------------------------------------------------------------
# Ignore actual .env files containing local configurations and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.pem
*.key
*.cert

# Do NOT ignore environment template files
!.env.example
!backend/.env.example
!frontend/.env.example

