# AGV Intelligence Platform - Backend Configuration
# -------------------------------------------------------------
# Discrete Mathematics & Graph Theory Autonomous Warehouse Digital Twin

# Application Environment
AGV_DEBUG=True
AGV_API_PREFIX=/api

# CORS Allowed Origins (comma-separated or JSON array)
# In production, add your deployed frontend URL (e.g. https://agv-intelligence.vercel.app)
AGV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Warehouse Grid Dimensions (8x8 academic benchmark)
AGV_WAREHOUSE__GRID_WIDTH=8
AGV_WAREHOUSE__GRID_HEIGHT=8
AGV_WAREHOUSE__CELL_SIZE_METERS=1.5
AGV_WAREHOUSE__MOVEMENT_COST=1.0

# Fleet Specifications
AGV_FLEET__ROBOT_COUNT=8
AGV_FLEET__NOMINAL_SPEED_MPS=1.0
AGV_FLEET__MAX_BATTERY_CAPACITY_KWH=10.0
AGV_FLEET__LOW_BATTERY_THRESHOLD=25.0
AGV_FLEET__CRITICAL_BATTERY_THRESHOLD=10.0
AGV_FLEET__BATTERY_DRAIN_PER_MOVE=0.5
AGV_FLEET__BATTERY_CHARGE_PER_TICK=4.0

# Simulation Timing
AGV_SIMULATION__TICK_INTERVAL_MS=800
AGV_SIMULATION__MAX_SIMULATION_STEPS=1000
AGV_SIMULATION__DEADLOCK_DETECTION_INTERVAL=1
