# =====================================================================
# AGV Intelligence Platform — Unified Environment Configuration Example
# =====================================================================
# Academic Experiential Learning Project
# Discrete Mathematics & Graph Theory Autonomous Guided Vehicle Simulation
#
# Instructions:
# 1. Backend: Copy variables into `backend/.env` for local backend execution
# 2. Frontend: Copy variables into `frontend/.env` for local frontend execution
# 3. Cloud Deployment: Set these in your cloud provider's Environment settings

# ---------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# ---------------------------------------------------------------------
AGV_DEBUG=True
AGV_API_PREFIX=/api

# Allowed origins for CORS (comma-separated or JSON list)
# For local dev:
AGV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# For production (replace with your deployed frontend domain):
# AGV_CORS_ORIGINS=https://your-agv-frontend.vercel.app,https://your-agv-frontend.netlify.app

# Warehouse Grid & Fleet Topology
AGV_WAREHOUSE__GRID_WIDTH=8
AGV_WAREHOUSE__GRID_HEIGHT=8
AGV_WAREHOUSE__CELL_SIZE_METERS=1.5
AGV_WAREHOUSE__MOVEMENT_COST=1.0

# Fleet Specifications (8 AGVs)
AGV_FLEET__ROBOT_COUNT=8
AGV_FLEET__NOMINAL_SPEED_MPS=1.0
AGV_FLEET__MAX_BATTERY_CAPACITY_KWH=10.0
AGV_FLEET__LOW_BATTERY_THRESHOLD=25.0
AGV_FLEET__CRITICAL_BATTERY_THRESHOLD=10.0
AGV_FLEET__BATTERY_DRAIN_PER_MOVE=0.5
AGV_FLEET__BATTERY_CHARGE_PER_TICK=4.0

# Simulation Discrete-Time Clock
AGV_SIMULATION__TICK_INTERVAL_MS=800
AGV_SIMULATION__MAX_SIMULATION_STEPS=1000
AGV_SIMULATION__DEADLOCK_DETECTION_INTERVAL=1

# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# ---------------------------------------------------------------------
# Local Development:
VITE_API_URL=http://localhost:8000/api

# Production Web Deployment (point to your deployed backend URL):
# VITE_API_URL=https://your-agv-backend.onrender.com/api
